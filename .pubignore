# Files excluded from the published pub.dev package (does NOT affect git).
# Uses .gitignore syntax.
#
# NOTE: once a .pubignore exists, pub walks the filesystem instead of using
# `git ls-files`, so normally-untracked build artifacts (.dart_tool/, build/)
# are NO LONGER auto-excluded and must be listed here explicitly.

# Build artifacts & tool caches
build/
.dart_tool/
pubspec.lock

# Development tooling. tool/ holds the Dart generators and the Node +
# Playwright browser suite — none of it is useful to package consumers, and
# the Node code must never ship to pub.dev.
tool/
node_modules/

# Kept in git, not needed by package consumers:
# - js/ is embedded verbatim in lib/src/generated/script_source.g.dart, so
#   shipping it would duplicate it.
# - test/ (tests, golden vectors, fixtures) runs from a clone of the repo.
# analysis_options.yaml DOES ship: it sets the 120-column formatter width, and
# without it pub.dev's formatter check fails every file (-10 points).
js/
test/

# Internal project docs (AI/dev support notes)
CLAUDE.md

# Editor / IDE state
.idea/
.vscode/
*.iml
.DS_Store
